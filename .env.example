APP_NAME="Clinica Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==== Base de datos (MySQL, según Arquitectura del Sistema ya definida) ====
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=clinica_digital
DB_USERNAME=clinica_user
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# ==== Redis (caché, sesiones y colas) ====
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ==== Correo (notificaciones de citas - plan gratuito) ====
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notificaciones@clinicademo.gt
MAIL_FROM_NAME="${APP_NAME}"

# ==== WhatsApp Business API (notificaciones - plan premium) ====
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=

# ==== phpMyAdmin ====
PMA_HOST=db
PMA_PORT=3306
